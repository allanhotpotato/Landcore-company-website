# Resend API key for the demo-request form (server-side only).
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: verified Resend sender address.
# Defaults to "Landcore Demo <onboarding@resend.dev>" (Resend's shared test sender).
# In production, use a sender on a domain you've verified in Resend, e.g.
# "Landcore Demo <demos@send.landcoreai.com>". A "send." subdomain keeps the
# root domain's Microsoft 365 MX/SPF/DKIM untouched.
RESEND_FROM=
